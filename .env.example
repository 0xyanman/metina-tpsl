# Metina Pro — no private key is stored there.
METINA_URL=https://pro.metina.id
METINA_EMAIL=
METINA_PASSWORD=

# Stays on THIS machine only. Never commit this file.
EVM_PRIVATE_KEY=0x

# Required — copy the same RPC URLs from Settings (browser only, not on the server).
# Fill every chain you have positions on.
RPC_ROBINHOOD=
RPC_BASE=
RPC_BSC=
# RPC_ETHEREUM=

# How often to refresh open positions (ms). Desk tab uses 45000.
POLL_MS=45000

# Full NFT rediscover every N polls (~6 min at 45s).
DISCOVER_EVERY=8

# 0 = log what would close, do not send close.
# 1 = actually close + swap when SL/TP hits.
LIVE_CLOSE=0

# Telegram (optional — kosong = notifikasi off)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=          # chat / group / channel ID
TELEGRAM_MESSAGE_THREAD_ID= # optional: forum topic / channel thread
TELEGRAM_ENABLED=1         # 0 = matikan tanpa hapus token

